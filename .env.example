# API Configuration
API_HOST=0.0.0.0
API_PORT=8080
API_DB_PATH=/data/promo.db

# Bridge Configuration
BRIDGE_API_URL=http://api:8080
BRIDGE_SESSION_PATH=/data/whatsapp.db
BRIDGE_QR_TERMINAL=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=20

# Language (fr|en)
DEFAULT_LANGUAGE=fr

# Mock Services
MOCK_TELECOM_DELAY_MS=500
MOCK_ANTIFRAUD_ENABLED=true
